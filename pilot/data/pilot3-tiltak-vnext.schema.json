{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_version",
    "status",
    "distribution_gate",
    "scope",
    "actions",
    "contacts",
    "sources"
  ],
  "properties": {
    "content_version": {
      "type": "string"
    },
    "status": {
      "const": "UTKAST"
    },
    "distribution_gate": {
      "const": "BLOCKED"
    },
    "scope": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "priority",
          "relevantFacts",
          "conditions",
          "contactId",
          "sourceIds",
          "statement",
          "prepare"
        ],
        "properties": {
          "id": {
            "enum": [
              "housing",
              "expenses",
              "general"
            ]
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "relevantFacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "contactId": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "statement": {
            "type": "string"
          },
          "prepare": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          },
          "fallback": {
            "type": "boolean"
          }
        }
      }
    },
    "contacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "url",
          "access",
          "hours",
          "alternative"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "access": {
            "const": "UNKNOWN"
          },
          "hours": {
            "type": "null"
          },
          "alternative": {
            "type": "null"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "retrievedAt",
          "reviewedAt",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "retrievedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reviewedAt": {
            "type": "null"
          },
          "scope": {
            "type": "string"
          }
        }
      }
    }
  }
}
