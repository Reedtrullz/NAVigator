{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local access verification update layer V1",
  "type": "object",
  "required": ["task_id", "layer_type", "target_count", "targets"],
  "properties": {
    "task_id": {"type": "string"},
    "layer_type": {"const": "UPDATE_LAYER"},
    "created_at": {"type": "string"},
    "parent_artifacts": {"type": "array", "items": {"type": "string"}},
    "target_count": {"const": 9},
    "targets": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["target_id", "kommune", "service_name", "before", "after", "outcome", "evidence", "search_log"],
        "properties": {
          "target_id": {"type": "string", "pattern": "^T[1-9]$"},
          "kommune": {"type": "string"},
          "kommunenummer": {"type": "string"},
          "service_name": {"type": "string"},
          "service_category": {"type": "string"},
          "before": {"type": "object", "required": ["access_clear"], "properties": {"access_clear": {"const": "no"}, "existing_access_model": {"type": "array"}, "existing_source_url": {"type": "string"}}},
          "after": {
            "type": "object",
            "required": ["access_clear", "canonical_access_methods", "self_referral", "route_confidence"],
            "properties": {
              "access_clear": {"enum": ["yes", "partial", "no"]},
              "canonical_access_methods": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "self_referral": {"enum": ["YES", "NO", "CONDITIONAL", "UNCLEAR"]},
              "self_referral_note": {"type": "string"},
              "route_confidence": {"enum": ["ROUTE_FULLY_VERIFIED", "ROUTE_ACCESS_PARTIAL", "ROUTE_EXISTENCE_ONLY", "ROUTE_UNVERIFIED"]}
            }
          },
          "outcome": {"enum": ["RESOLVED", "PARTIALLY_RESOLVED", "PUBLIC_DATA_EXHAUSTED"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["quote", "source_url", "retrieved_date", "discovered_via"], "properties": {"quote": {"type": "string"}, "source_url": {"type": "string"}, "source_page_last_updated": {"type": ["string", "null"]}, "retrieved_date": {"type": "string"}, "discovered_via": {"type": "string"}}}},
          "evidence_edges": {"type": "array"},
          "intermunicipal_provenance": {"type": "object"},
          "search_log": {
            "type": "object",
            "required": ["level_0", "level_1", "level_2", "level_3", "level_4", "level_5", "terminal_state", "inspected_urls"],
            "properties": {
              "level_0": {"type": "boolean"}, "level_1": {"type": "boolean"}, "level_2": {"type": "boolean"},
              "level_3": {"type": "boolean"}, "level_4": {"type": "boolean"}, "level_5": {"type": "boolean"},
              "terminal_state": {"enum": ["ACCESS_VERIFIED", "REFERRAL_VERIFIED", "PUBLIC_DATA_EXHAUSTED"]},
              "queries": {"type": "array"},
              "inspected_urls": {"type": "array", "minItems": 1},
              "edges": {"type": "array"},
              "rejected": {"type": "array"}
            }
          }
        }
      }
    }
  }
}
