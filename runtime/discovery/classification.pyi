from .contracts import Classification, Extract, GraphEdge, LedgerEntry

class EvidenceLedger:
    entries: list[LedgerEntry]
    def __init__(self) -> None: ...
    def add(self, field: str, value: str, source_url: str, source_title: str | None,
            span: str, retrieved_at: str, fetch_method: str, content_hash: str | None,
            confidence_state: str) -> LedgerEntry: ...
    def has_evidence_for(self, field: str) -> bool: ...
    def get(self, field: str) -> list[LedgerEntry]: ...

class AccessClassifier:
    def classify(self, page_extract: Extract | None, service_context: object = None) -> Classification: ...

class RouteEvaluator:
    def evaluate(self, service_verified: bool, eligibility_verified: bool,
                 access_methods: list[str], access_clear: bool, contact_documented: bool,
                 strong_access: bool | None = None) -> str: ...

class ProvenanceGraph:
    edges: list[GraphEdge]
    def __init__(self) -> None: ...
    def add_edge(self, from_node: str, to_node: str, discovery_method: str,
                 query_family: str | None = None, level: int | None = None) -> GraphEdge: ...
    def trace_back(self, target_url: str) -> list[GraphEdge]: ...
