{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nav-explore.local/provider-contract-v2.schema.json",
  "title": "DiscoveryProvider Contract V2",
  "type": "object",
  "required": [
    "query",
    "status",
    "results",
    "error"
  ],
  "properties": {
    "query": {
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "NO_RESULTS",
        "RATE_LIMITED",
        "BOT_BLOCKED",
        "AUTH_REQUIRED",
        "PROVIDER_UNAVAILABLE",
        "TIMEOUT",
        "INVALID_RESPONSE",
        "INTERNAL_ERROR"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": "string"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "title",
          "snippet",
          "provider",
          "rank"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "discovery_method": {
      "enum": [
        "KNOWN_PAGE_CONTENT",
        "NAVIGATION_LINK",
        "SITE_SEARCH",
        "SITEMAP",
        "QUERY_SEARCH",
        "INTERMUNICIPAL_CHAIN",
        "OFFICIAL_EXTERNAL_PORTAL"
      ]
    }
  },
  "additionalProperties": true
}
