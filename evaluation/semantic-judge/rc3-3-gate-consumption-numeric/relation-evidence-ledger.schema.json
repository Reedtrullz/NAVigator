{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RELATION_EVIDENCE_LEDGER_V1",
  "type": "object",
  "required": ["dimensions", "numeric_quantities", "clause_coverage", "provenance_span_ids", "rule_ids", "unresolved_dimensions"],
  "properties": {
    "dimensions": {
      "type": "object",
      "required": ["polarity", "modality", "condition", "exception", "actor", "scope", "temporal", "clause_coverage"],
      "description": "Per-dimension state objects from frozen boundary.compare dimension_evidence."
    },
    "numeric_quantities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["quantity_type", "value", "unit", "comparator", "role", "derivation", "relation", "provenance"],
        "properties": {
          "quantity_type": {"enum": ["AGE", "DATE", "DURATION", "MONEY", "PERCENTAGE", "RATE", "COUNT", "THRESHOLD", "PERIOD", "AGGREGATE", "COMPONENT", "OTHER"]},
          "value": {"type": ["number", "null"]},
          "range_bounds": {"type": ["array", "null"], "items": {"type": "number"}},
          "unit": {"type": ["string", "null"]},
          "comparator": {"enum": ["=", ">", ">=", "<", "<=", "BETWEEN", "APPROXIMATE", "UNKNOWN"]},
          "period": {"type": ["string", "null"]},
          "object_binding": {"type": ["string", "null"]},
          "role": {"enum": ["AGGREGATE", "COMPONENT", "STANDALONE"]},
          "derivation": {"enum": ["DIRECT", "DERIVED", "UNKNOWN"]},
          "relation": {"enum": ["ENTAILS", "CONTRADICTS", "NUMERIC_RELEVANT_BUT_UNRESOLVED", "NOT_APPLICABLE"]},
          "provenance": {"type": "object", "properties": {"claim_span": {"type": "string"}, "evidence_span": {"type": ["string", "null"]}}}
        }
      }
    },
    "clause_coverage": {"type": "string"},
    "provenance_span_ids": {"type": "array", "items": {"type": "string"}},
    "rule_ids": {"type": "array", "items": {"type": "string"}},
    "unresolved_dimensions": {"type": "array", "items": {"type": "string"}}
  }
}
