{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evaluation contract dual-label dataset",
  "type": "object",
  "required": ["schema", "task_id", "cases"],
  "properties": {
    "schema": {"const": "evaluation-contract-dual-labels-v1"},
    "task_id": {"const": "SEMANTIC-JUDGE-EVALUATION-CONTRACT-REDESIGN"},
    "provenance": {"type": "string"},
    "label_definitions_note": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "set", "original_benchmark_label", "semantic_truth", "proof_safe", "annotation_status"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "set": {"type": "string"},
          "dimension": {"type": "string"},
          "kind": {"type": "string"},
          "claim": {"type": "string"},
          "source_text": {"type": "string"},
          "kb_ref": {"type": ["array", "string"]},
          "original_benchmark_label": {
            "enum": ["SUPPORTED", "CONTRADICTED", "PARTIALLY_SUPPORTED", "PARTIAL", "INSUFFICIENT", "INSUFFICIENT_EVIDENCE"]
          },
          "semantic_truth": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": {"enum": ["SUPPORTED", "CONTRADICTED", "PARTIALLY_SUPPORTED", "PARTIAL", "INSUFFICIENT", "INSUFFICIENT_EVIDENCE"]},
              "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
              "required_inference": {"type": ["string", "array"]}
            }
          },
          "proof_safe": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": {"enum": ["SUPPORTED", "CONTRADICTED", "PARTIALLY_SUPPORTED", "PARTIAL", "INSUFFICIENT", "INSUFFICIENT_EVIDENCE", "REVIEW_REQUIRED"]},
              "reason": {"type": "string"},
              "gate_reason": {"type": "string"}
            }
          },
          "operator_class": {"enum": ["SAFE_FOR_AUTO_PROOF", "SAFE_WITH_PRECONDITIONS", "REVIEW_ONLY", "FORBIDDEN", "NONE"]},
          "mismatch_taxonomy": {"type": "string"},
          "annotation_status": {"enum": ["CONFIRMED", "ANNOTATION_DISPUTE"]},
          "two_pass": {"type": "object"},
          "justification": {"type": "string"},
          "evidence_spans": {"type": ["array", "string"]},
          "note": {"type": "string"}
        }
      }
    }
  }
}
