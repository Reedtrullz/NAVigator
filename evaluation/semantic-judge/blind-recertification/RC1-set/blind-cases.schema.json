{
  "schema": "http://json-schema.org/draft-07/schema#",
  "title": "NAV-EXPLORE-RC1-BLIND-V1 public blind cases",
  "type": "object",
  "required": ["set_version", "created", "core", "reserve"],
  "properties": {
    "set_version": {"const": "NAV-EXPLORE-RC1-BLIND-V1"},
    "created": {"type": "string", "format": "date"},
    "core": {"type": "array", "minItems": 120, "maxItems": 120, "items": {"$ref": "#/definitions/case"}},
    "reserve": {"type": "array", "items": {"$ref": "#/definitions/case"}}
  },
  "definitions": {
    "case": {
      "type": "object",
      "required": ["case_id", "claim", "sources"],
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "pattern": "^RC1B-[0-9]{4}$"},
        "claim": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_id", "kb_ref", "text"],
            "additionalProperties": false,
            "properties": {
              "source_id": {"type": "string"},
              "kb_ref": {"type": "string"},
              "text": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
